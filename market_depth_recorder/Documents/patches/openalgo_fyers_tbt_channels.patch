     # POST inside FyersAdapter.subscribe_symbols instead of N sequential ones.
     HSM_BATCH_DELAY_SEC = 0.15
 
+    # FYERS TBT (50-level depth) caps Market-Depth subscriptions at 5 symbols per
+    # CONNECTION. The feed also exposes 50 channels per connection, but channels are
+    # a pause/resume logical grouping and carry NO additional capacity -- they do not
+    # multiply the 5-symbol limit. The real per-app ceiling is 3 connections x 5 = 15
+    # concurrent 50-level symbols.
+    #
+    # CORRECTION (2026-07-14): this block previously claimed the cap was 5 PER CHANNEL,
+    # giving 5*50 = 250. That was wrong. Established by the official FYERS TBT docs, a
+    # single-connection probe, a multi-connection probe, and a re-read of two live
+    # session captures. Frozen absent new external evidence.
+    #
+    # The channel-spreading below is kept because it is harmless and its channel-resume
+    # plumbing is correct; it simply buys 15, not 250. TBT_MAX_CHANNELS is the true
+    # channel count (1-50) and TBT_SYMBOLS_PER_CHANNEL is the true symbol-count limit
+    # the server enforces -- but the two must NOT be multiplied into a budget. The
+    # resulting 250 bound in _assign_tbt_channel is therefore unreachable: FYERS
+    # refuses the 6th Market-Depth symbol on a connection long before it is hit.
+    # Previously every 50-depth sub was pinned to channel "1", so FYERS rejected the
+    # whole channel past the 5th symbol ("symbol count exceeds limit: 5").
+    TBT_SYMBOLS_PER_CHANNEL = 5
+    TBT_MAX_CHANNELS = 50
+
     def __init__(self):
         super().__init__()
         self.logger = logging.getLogger("fyers_websocket_adapter")
