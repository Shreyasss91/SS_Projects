@@ -50,6 +50,14 @@ class FyersWebSocketAdapter(BaseBrokerWebSocketAdapter):
     # POST inside FyersAdapter.subscribe_symbols instead of N sequential ones.
     HSM_BATCH_DELAY_SEC = 0.15
 
+    # FYERS TBT (50-level depth) caps at 5 symbols PER CHANNEL. The feed exposes
+    # channels 1-50, so packing subscriptions 5-per-channel lifts the ceiling from
+    # 5 to 5*50 = 250 symbols. Previously every 50-depth sub was pinned to channel
+    # "1", so FYERS rejected the whole channel past the 5th symbol
+    # ("symbol count exceeds limit: 5"), silently starving large 50-depth chains.
+    TBT_SYMBOLS_PER_CHANNEL = 5
+    TBT_MAX_CHANNELS = 50
+
     def __init__(self):
         super().__init__()
         self.logger = logging.getLogger("fyers_websocket_adapter")
@@ -619,6 +627,31 @@ class FyersWebSocketAdapter(BaseBrokerWebSocketAdapter):
         except Exception as e:
             self.logger.error(f"Error in _flush_hsm_batch: {e}")
 
+    def _assign_tbt_channel(self, subscription_key: str) -> Optional[str]:
+        """Pick the FYERS TBT channel for a 50-depth symbol, packing
+        ``TBT_SYMBOLS_PER_CHANNEL`` symbols per channel across channels
+        ``1..TBT_MAX_CHANNELS``.
+
+        Re-subscribing an already-known symbol reuses its channel (stable across
+        reconnects — the TBT client resubscribes per its stored channel). A new
+        symbol fills the lowest-numbered channel that still has a free slot.
+        Returns ``None`` when the whole budget is exhausted. The caller holds
+        ``self.lock``, so reading ``tbt_subscriptions`` here is race-free.
+        """
+        existing = self.tbt_subscriptions.get(subscription_key)
+        if existing and existing.get("channel"):
+            return existing["channel"]
+        counts: dict[str, int] = {}
+        for sub in self.tbt_subscriptions.values():
+            ch = sub.get("channel")
+            if ch:
+                counts[ch] = counts.get(ch, 0) + 1
+        for n in range(1, self.TBT_MAX_CHANNELS + 1):
+            ch = str(n)
+            if counts.get(ch, 0) < self.TBT_SYMBOLS_PER_CHANNEL:
+                return ch
+        return None
+
     def _subscribe_tbt_depth(
         self, symbol: str, exchange: str, callback, original_symbol: str = None
     ) -> bool:
@@ -673,19 +706,33 @@ class FyersWebSocketAdapter(BaseBrokerWebSocketAdapter):
             subscription_key = f"{exchange}:{topic_symbol}"
             self.tbt_symbol_to_ticker[subscription_key] = fyers_ticker
             self.tbt_ticker_to_symbol[fyers_ticker] = subscription_key
+            # Spread 50-depth subs across TBT channels (5/channel) instead of
+            # pinning everything to channel "1" — see TBT_SYMBOLS_PER_CHANNEL.
+            channel = self._assign_tbt_channel(subscription_key)
+            if channel is None:
+                self.logger.error(
+                    f"TBT channel budget exhausted "
+                    f"({self.TBT_MAX_CHANNELS} channels x {self.TBT_SYMBOLS_PER_CHANNEL} = "
+                    f"{self.TBT_MAX_CHANNELS * self.TBT_SYMBOLS_PER_CHANNEL} symbols); "
+                    f"cannot subscribe {fyers_ticker} for {exchange}:{symbol}"
+                )
+                return False
+
             self.tbt_subscriptions[subscription_key] = {
                 "ticker": fyers_ticker,
                 "exchange": exchange,
                 "symbol": topic_symbol,  # Use topic_symbol (with :50) for topic matching
                 "actual_symbol": symbol,  # Actual symbol for display
                 "callback": callback,
-                "channel": "1",
+                "channel": channel,
             }
 
             # Subscribe via TBT client
-            success = self.tbt_client.subscribe([fyers_ticker], channel="1")
+            success = self.tbt_client.subscribe([fyers_ticker], channel=channel)
             if success:
-                self.logger.info(f"TBT subscribed to {fyers_ticker} for {exchange}:{symbol}")
+                self.logger.info(
+                    f"TBT subscribed to {fyers_ticker} for {exchange}:{symbol} on channel {channel}"
+                )
                 return True
             else:
                 self.logger.error(f"TBT subscription failed for {fyers_ticker}")
