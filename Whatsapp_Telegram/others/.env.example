# Telegram Market Assistant — environment variables
# Copy to .env and fill in your values

# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENALGO_API_KEY=your_openalgo_api_key_here

# Optional (default: http://127.0.0.1:5000)
HOST_SERVER=http://127.0.0.1:5000

# Optional (default: bot.db in current directory)
# DB_PATH=/path/to/bot.db
