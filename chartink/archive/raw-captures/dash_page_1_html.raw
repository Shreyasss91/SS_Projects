    <title inertia>Chartink</title>

    <!-- Local jQuery -->
    <script src="https://chartink.com/assets/js/jquery-3.6.0.min.js"></script>

    
    <script>
	(function () {
		/*init default theme*/
		try {
			let LIGHT = 1, DARK = 2, SYSTEM = 3;
			let stored = Number(localStorage.getItem('theme')) || SYSTEM;
			let prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
			let wantDark = (stored === DARK) || (stored === SYSTEM && prefersDark);
			document.documentElement.classList.toggle('dark', !!wantDark);
		} catch(_) {}
	})();
</script>
    <style>
        .master-background{
            background: linear-gradient(#EAEEF9 0%, white 40%)
        }
